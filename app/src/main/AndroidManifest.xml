<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Solo para el tiempo junto a la hora (docs/PLAN.md §7): una petición a Open-Meteo, sin clave
        ni cuenta, con las coordenadas redondeadas a unos 1 km, y la búsqueda de una ciudad por su
        nombre, que solo se hace cuando el dueño escribe una en «Lugar» (también para el sol). Sin
        SDKs ni analítica. Con el tiempo apagado, Alisio no abre ninguna conexión por su cuenta.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Ubicación aproximada, nunca la precisa, para el tiempo y la salida del sol cuando no se ha
        fijado una ciudad. Se lee al volver al Inicio, nunca en segundo plano.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- El próximo evento de las próximas 12 horas en la línea bajo la hora. Solo lectura. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Personas en la barra (docs/PLAN.md §5.4). Sin CALL_PHONE, llamar abre el marcador. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Qué dispositivo de audio está conectado, para la regla Bluetooth de Ahora (docs/PLAN.md §5.5). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        «alarma 7:30» y «temporizador 10» en la barra (docs/PLAN.md §5.8). Permiso normal: se concede
        al instalar y solo deja pedirle al reloj que ponga una alarma.
    -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!--
        Acceso a uso, para el uso de hoy en el Interior de app (docs/PLAN.md §5.6). No se concede al
        instalar ni con un diálogo: el usuario lo da en los ajustes del sistema, y declararlo es lo
        que hace que Alisio salga en esa lista.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!--
        Fondos que rotan: poner como fondo del Inicio, una vez al día y al salir de él, una imagen de
        la carpeta que el dueño elige. Permiso normal: se concede al instalar.
    -->
    <uses-permission android:name="android.permission.SET_WALLPAPER" />

    <!--
        «brillo 40» y «rotación» en la barra. No se concede al instalar: el dueño lo da en los ajustes
        del sistema desde Ajustes → Permisos. Sin él, la orden abre el ajuste de pantalla.
    -->
    <uses-permission
        android:name="android.permission.WRITE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!--
        «no molestar» en la barra. Declararlo es lo que hace que Alisio salga en la lista del sistema
        donde se concede; sin el acceso, la orden abre el ajuste de No molestar.
    -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <!--
        «Desinstalar» en el Interior de app: abre el diálogo de confirmación del sistema, que desde
        Android 9 no sale sin este permiso. Permiso normal: se concede al instalar y no borra nada solo.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!-- CALL_PHONE da por hecho que hay telefonía; Alisio funciona igual sin ella. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <!-- La ubicación aproximada da por hecho que la hay; sin ella el tiempo va por ciudad. -->
    <uses-feature
        android:name="android.hardware.location"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.location.network"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Para saber si Claude está instalado y ofrecer «Preguntar a Claude» (docs/PLAN.md §5.3). -->
        <package android:name="com.anthropic.claude" />
        <!-- Para ofrecer los canales de WhatsApp de cada persona. -->
        <package android:name="com.whatsapp" />
        <!-- Apps entre las que se elige la búsqueda web en los ajustes: buscadores y navegadores. -->
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Paquetes de iconos (formato de ADW y Nova), también los que no tienen icono de inicio. -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
    </queries>

    <application
        android:name=".AlisioApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Alisio"
        tools:ignore="DataExtractionRules">

        <!-- Atributos de referencia de Launcher3 (docs/PLAN.md §5.1). Solo en vertical: el Inicio, Trazo
             y los gestos están hechos para el móvil de pie y en horizontal se descolocaban (docs/PLAN.md
             §11). Android 16 ignora el bloqueo en pantallas grandes; en el S26 se respeta. -->
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:screenOrientation="portrait"
            tools:ignore="LockedOrientationActivity"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- LAUNCHER solo mientras se desarrolla. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            «Añadir a inicio» desde otra app (docs/IDEAS.md §2.3): el sistema se la abre al launcher
            activo con la petición de fijar un acceso directo. Sin el filtro de widgets a propósito: el
            sistema les diría a las apps que Alisio los acepta. Exportada porque la abre el sistema; una
            app que la abra a mano no trae petición válida y la hoja se cierra sin hacer nada.
        -->
        <activity
            android:name=".PinShortcutActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Alisio.Sheet">
            <intent-filter>
                <action android:name="android.content.pm.action.CONFIRM_PIN_SHORTCUT" />
            </intent-filter>
        </activity>

        <!--
            Compartir un texto o un enlace con Alisio desde cualquier app lo guarda como nota del
            Inicio. Sin ventana: guarda, avisa y se cierra. Con las notas apagadas en los ajustes se
            deshabilita, y Alisio deja de salir en la hoja de compartir.
        -->
        <activity
            android:name=".ShareNoteActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/note_share_label"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
            Lo enlaza el sistema cuando el usuario concede el acceso a notificaciones: reproductor y
            puntos de no leído (docs/PLAN.md §5.5). Alisio no arranca ningún servicio: este y el de
            accesibilidad los enlaza el sistema, y solo si el usuario los activa.
        -->
        <service
            android:name=".data.media.AlisioNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Opcional y apagado hasta que el usuario lo activa en los ajustes de accesibilidad del
            sistema (docs/PLAN.md §5.8). Solo sirve para bloquear la pantalla y bajar las
            notificaciones; su configuración no pide eventos ni el contenido de las ventanas.
        -->
        <service
            android:name=".data.accessibility.AlisioAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
