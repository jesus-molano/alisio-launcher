<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sin INTERNET: lo vigila el task checkNoInternetPermission (docs/PLAN.md §7). -->

    <!-- Personas en la barra (docs/PLAN.md §5.4). Sin CALL_PHONE, llamar abre el marcador. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Qué dispositivo de audio está conectado, para la regla Bluetooth de Ahora (docs/PLAN.md §5.5). -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!--
        «alarma 7:30» y «temporizador 10» en la barra (docs/PLAN.md §5.8). Permiso normal: se concede
        al instalar y solo deja pedirle al reloj que ponga una alarma.
    -->
    <uses-permission android:name="com.android.alarm.permission.SET_ALARM" />

    <!--
        Acceso a uso, para el uso de hoy en el Interior de app (docs/PLAN.md §5.6). No se concede al
        instalar ni con un diálogo: el usuario lo da en los ajustes del sistema, y declararlo es lo
        que hace que Alisio salga en esa lista.
    -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- CALL_PHONE da por hecho que hay telefonía; Alisio funciona igual sin ella. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Para saber si Claude está instalado y ofrecer «Preguntar a Claude» (docs/PLAN.md §5.3). -->
        <package android:name="com.anthropic.claude" />
        <!-- Para ofrecer los canales de WhatsApp de cada persona. -->
        <package android:name="com.whatsapp" />
        <!-- Apps entre las que se elige la búsqueda web en los ajustes: buscadores y navegadores. -->
        <intent>
            <action android:name="android.intent.action.WEB_SEARCH" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <!-- Paquetes de iconos (formato de ADW y Nova), también los que no tienen icono de inicio. -->
        <intent>
            <action android:name="org.adw.launcher.THEMES" />
        </intent>
        <intent>
            <action android:name="com.novalauncher.THEME" />
        </intent>
    </queries>

    <application
        android:name=".AlisioApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Alisio"
        tools:ignore="DataExtractionRules">

        <!-- Atributos de referencia de Launcher3 (docs/PLAN.md §5.1). -->
        <activity
            android:name=".MainActivity"
            android:clearTaskOnLaunch="true"
            android:configChanges="keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:resumeWhilePausing="true"
            android:stateNotNeeded="true"
            android:taskAffinity=""
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <!-- LAUNCHER solo mientras se desarrolla. -->
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lo enlaza el sistema cuando el usuario concede el acceso a notificaciones: reproductor y
            puntos de no leído (docs/PLAN.md §5.5). Alisio no arranca ningún servicio: este y el de
            accesibilidad los enlaza el sistema, y solo si el usuario los activa.
        -->
        <service
            android:name=".data.media.AlisioNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            Opcional y apagado hasta que el usuario lo activa en los ajustes de accesibilidad del
            sistema (docs/PLAN.md §5.8). Solo sirve para bloquear la pantalla y bajar las
            notificaciones; su configuración no pide eventos ni el contenido de las ventanas.
        -->
        <service
            android:name=".data.accessibility.AlisioAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
